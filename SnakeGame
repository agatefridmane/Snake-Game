import turtle
import random
import time
import os

screen = turtle.Screen()
screen.title("Snake Game")
screen.bgcolor("green")
screen.setup(width=600, height=600)
screen.tracer(0)

head = turtle.Turtle()
head.speed(0)
head.shape("square")
head.color("black")
head.penup()
head.goto(0, 0)
head.direction = "stop"

food = turtle.Turtle()
food.speed(0)
food.shape("circle")
food.color("red")
food.penup()
food.goto(random.randint(-100, 100), random.randint(-100, 100))

segments = []

score_display = turtle.Turtle()
score_display.speed(0)
score_display.color("black")
score_display.penup()
score_display.hideturtle()
score_display.goto(0, 280)
leave_display = turtle.Turtle()
leave_display.speed(0)
leave_display.color("black")
leave_display.penup()
leave_display.hideturtle()
leave_display.goto(0, -280)
leave_display.write("Ja vēlaties izietr no spēles, spiežat 'L'!", align="center", font=("Courier", 10, "normal"))

score = 0
path = "high_score.txt"
if os.path.isfile(path):
    with open(path, "r") as file:
        high_score = int(file.read())
else: 
    high_score = 0

foods_eaten = 0
speed_threshold = 5
initial_sleep_duration = 0.1
sleep_duration_step = 0.01

def write_high_score(score):
    with open("high_score.txt", "w") as file:
        file.write(str(score))

def read_high_score():
    try:
        with open("high_score.txt", "r") as file:
            return int(file.read())
            high_score = file.read().split()
    except FileNotFoundError:
        write_high_score(0)
        return 0

def update_score():
    global score, high_score
    score_display.clear()
    score_display.write(f"Score:{score}  High Score:{high_score}", align="center", font=("Courier", 10, "normal"))

def go_up():
    if head.direction != "down":
        head.direction = "up"
    # print("UP")
def go_down():
    if head.direction != "up":
        head.direction = "down"
    # print("DOWN")
def go_left():
    if head.direction != "right":
        head.direction = "left"
    # print("LEFT")
def go_right():
    if head.direction != "left":
        head.direction = "right"
    # print("RIGHT")
def leave():
    global status
    teksts = turtle.textinput("Ieziet?", "Vai patiešām vēlaties iziet no spēles? Jā vai nē?")
    if teksts.lower().strip() == "jā":
        status = False
    

def move():
    if head.direction == "up":
        y = head.ycor()
        head.sety(y + 20)

    if head.direction == "down":
        y = head.ycor()
        head.sety(y - 20)

    if head.direction == "left":
        x = head.xcor()
        head.setx(x - 20)

    if head.direction == "right":
        x = head.xcor()
        head.setx(x + 20)
    


def check_collision():
    global score, high_score
    if head.distance(food) < 20:
        x = random.randint(-280, 280)
        y = random.randint(-280, 280)
        food.goto(x, y)

        papildinajumi = turtle.Turtle()
        papildinajumi.speed(0)
        papildinajumi.shape("square")
        papildinajumi.color("black")
        papildinajumi.penup()
        segments.append(papildinajumi)

        score += 1
        update_score()

        if score > high_score:
            high_score = score
            write_high_score(high_score)

            high_score = read_high_score()
            update_score()



def game_over():
    if (head.xcor() > 290 or head.xcor() < -290 or 
        head.ycor() > 290 or head.ycor() < -290):
        return True
    
    for segment in segments[1:]:  # Start from index 1 to avoid checking collision with the head
        if head.distance(segment) < 20:
            return True

    return False

screen.onkeypress(go_up, "w")
screen.onkeypress(go_up, "W")
screen.onkeypress(go_down, "s")
screen.onkeypress(go_down, "S")
screen.onkeypress(go_left, "a")
screen.onkeypress(go_left, "A")
screen.onkeypress(go_right, "d")
screen.onkeypress(go_right, "D")
screen.onkeypress(leave, "l")
screen.onkeypress(leave, "L")

update_score()
status = True
while status == True:
    screen.listen()
    screen.update()
    # time.sleep(0.1) #time.sleep() - when the statement time.sleep(t) is executed then the next line of code will be executed after t seconds
    time.sleep(initial_sleep_duration - (score// speed_threshold) * sleep_duration_step)


    move()

    if game_over():
        head.goto(0, 0)
        head.direction = "stop"
        for segment in segments:
            segment.goto(1000, 1000)
        segments.clear()

        score = 0
        update_score()

    check_collision()

    for index in range(len(segments) - 1, 0, -1):
        x = segments[index - 1].xcor()
        y = segments[index - 1].ycor()
        segments[index].goto(x, y)

    if len(segments) > 0:
        x = head.xcor()
        y = head.ycor()
        segments[0].goto(x, y)

    

